{
  "name": "team-me-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Claude connector (remote MCP server) and shared backend for the Team Me Command Center",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "hash-passphrase": "node dist/src/scripts/hash-passphrase.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
